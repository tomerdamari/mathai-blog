---
layout: base.njk
---
<article class="post">
  <div class="wrap narrow">
    <p class="eyebrow"><a href="/articles/">Articles</a> <span aria-hidden="true">/</span> {{ category }}</p>
    <h1>{{ title }}</h1>
    <p class="lede">{{ description }}</p>
    <p class="byline">
      <span>{{ author or "The Editors" }}</span>
      <span aria-hidden="true">&middot;</span>
      <time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>
      <span aria-hidden="true">&middot;</span>
      <span>{{ readingTime or "8 min read" }}</span>
    </p>
  </div>
  <div class="wrap narrow prose">
    {{ content | safe }}
  </div>
  <div class="wrap narrow">
    <hr class="rule">
    <p class="muted small">Corrections and counter-arguments are welcome. Write to us through the <a href="/contact/">contact page</a> and we will publish the ones that change our mind.</p>
    <p><a class="btn" href="/articles/">&larr; Back to all articles</a></p>
  </div>
</article>
